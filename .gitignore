# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables files
.env
*.env

# Virtual environment folders
venv/
env/
ENV/

# Django stuff:
*.sqlite3
db.sqlite3

# Migraciones (excepto __init__.py para que Django reconozca las carpetas)
*/migrations/*.py
!*/migrations/__init__.py

# Archivos estáticos generados
/staticfiles/
/static/

# Logs
*.log

# IDEs y editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# MacOS
.DS_Store

# Windows
Thumbs.db

# Otros archivos temporales
*.swp
*.tmp
*.bak
